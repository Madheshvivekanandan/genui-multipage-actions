# Copy this file to .env.local and paste your key after the = sign.
# Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: which model to use, as "vendor/model" (default: google/gemini-3.5-flash).
# Any model on https://openrouter.ai/models works.
# OPENROUTER_MODEL=google/gemini-3.5-flash
